# Public domain (DNS must point to the server)
DOMAIN=socialflow.example.com

# PostgreSQL
POSTGRES_DB=socialflow
POSTGRES_USER=socialflow
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

# Security — generate independent values (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-separate-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-another-strong-random-secret

# Uploads
MAX_UPLOAD_MB=25
# Instagram Reels/video uploads. Meta supports Reel files up to 1 GB.
MAX_VIDEO_UPLOAD_MB=1024

# Meta API version
META_GRAPH_API_VERSION=v26.0

# Social OAuth apps — leave blank to disable that provider
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202607
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Never silently create fake accounts in production
ALLOW_DEMO_SOCIAL_CONNECTIONS=false

# Optional transactional email (Resend-compatible API)
RESEND_API_KEY=
EMAIL_FROM="SocialFlow <notifications@example.com>"

# AI provider (or configure per workspace in Settings → AI Provider)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# Location suggestions in Composer (Geoapify Address Autocomplete)
# Create a free key at https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=""
# Optional: restrict results to one country, e.g. in, us, gb
LOCATION_SEARCH_COUNTRY_CODE=""
# Optional Geoapify bias, e.g. proximity:73.8567,18.5204 for Pune
LOCATION_SEARCH_BIAS=""
